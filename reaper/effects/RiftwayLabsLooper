function onblock()
  instance(rec peak_in monmode_sel monmode idx mgate_t)
  global(g_peak_decay st_peak_in srate last_w g_length g_any_solo g_solo_mask st_mute)
(
  rec[st_peak_in] = peak_in;
  peak_in *= g_peak_decay;
  // RiftwayLabsLooper: per-track output-gate target. Any solo active -> only soloed tracks
  // sound (mute ignored for them); otherwise mute gates this track.
  mgate_t = g_any_solo ? ((g_solo_mask & (1<<idx)) ? 1 : 0) : (rec[st_mute] ? 0 : 1);
  monmode_sel = monmode >= 2 || is_chan_selected(idx);
  this.rev_state == 0 || !g_length ? (
    this.rev_requested && atomic_exch(this.rev_state=0,this.rev_requested) ? (
      this.rev_state &= 1;
      this.rev_pos = -1;
    );
  );
  this.rev_state !== 0 ? last_w=-1; // force redraw if reversing this block
);

// RiftwayLabsLooper: compute the solo mask once per block, before the per-channel onblock().
// Same pass also builds the "wants live input" mask (armed for a quantized start,
// recording/overdubbing, or counting in) published to gmem for the arm bridge.
g_solo_mask = 0;
g_s505_wantmask = g_arm_mask;
s505_i = 0;
loop(g_nchan,
  mem_stlist[s505_i*st_num + st_solo] ? (g_solo_mask |= (1<<s505_i));
  mem_stlist[s505_i*st_num + st_state] == 2 ? (g_s505_wantmask |= (1<<s505_i));
  s505_i += 1;
);
g_any_solo = g_solo_mask != 0;
g_ci_active && g_ci_chan >= 0 ? (g_s505_wantmask |= (1<<g_ci_chan));

// --- RiftwayLabsLooper arm bridge (gmem protocol, namespace "RiftwayLabs") ---
// scripts/RiftwayLabsLooper_arm_bridge.lua watches these and record-arms whichever
// REAPER tracks send into the flagged looper channels.
//   gmem[0] = heartbeat (increments every block while the FX runs)
//   gmem[1] = want-input bitmask (bit N = looper channel N+1)
//   gmem[2] = channel count
gmem[0] += 1;
gmem[1] = g_s505_wantmask;
gmem[2] = g_nchan;
<? loop(x=0;nch, printf("ch%d.onblock();\n",x+=1)) ?>

(g_click_int = (cfgp_clickcnt[]|0)) > 0 ?( 
  g_click_lenspls = (0.01*srate)|0;
  g_click_fadesz = (0.0041*srate)|0;
  g_click_fadesz_i = 1/g_click_fadesz;
);

i_srate = 1.0/srate;

// ============== RiftwayLabsLooper LED feedback (v2: ROWS = tracks) ==================
// Track i -> grid row (8-i); 8 columns per row:
//   col1 REC/PLAY/OD  col2 STOP  col3 CLEAR  col4 UNDO(stub)
//   col5 FX(stub)     col6 SOLO  col7 MUTE   col8 STATUS+SELECT
// Self-healing: enter Programmer mode once, then every ~0.5s repaint the static
// columns + blank the unused rows 1-3, and force the dynamic pads to re-send.
g_s505_phase == 0 ? (
  midisend_buf(0, mem_sysex_prog, 9);        // enter Programmer mode
  g_s505_phase = 1;
  g_s505_t = 0;
) : (
  g_s505_t += samplesblock;
  g_s505_t >= srate*0.5 ? (
    g_s505_t = 0;
    s505_i = 0;
    loop(min(g_nchan,5),
      s505_base = (8 - s505_i) * 10;             // track i -> grid row 8-i
      midisend(0, 0x90, s505_base+2, C_GREEN);   // col2 STOP  (static)
      midisend(0, 0x90, s505_base+3, C_AMBER);   // col3 CLEAR (static)
      midisend(0, 0x90, s505_base+4, C_UNDO_DIM);// col4 UNDO  (reserved/dim)
      s505_i += 1;
    );
    s505_i = 11;                                  // blank unused rows 1,3 (row 2 = action pads)
    loop(8,
      midisend(0, 0x90, s505_i,    C_OFF);
      midisend(0, 0x90, s505_i+20, C_OFF);
      s505_i += 1;
    );
    memset(mem_led_last, -1, 64);                 // force dynamic pads to re-send
    memset(mem_led_row2, -1, 8);                  // ...and the action row
  );
);

// Per-track dynamic pads, every block (send-on-change; idx = track*8 + col-1).
g_s505_phase >= 1 ? (
  s505_i = 0;
  loop(min(g_nchan,5),
    s505_rec  = mem_stlist + s505_i*st_num;
    s505_base = (8 - s505_i) * 10;
    s505_st   = s505_rec[st_state];
    s505_sel  = is_chan_selected(s505_i);

    // col1 REC/PLAY/OD (state color; ch2 = flashing)
    (g_arm_mask & (1<<s505_i)) ? (
      s505_col = C_RED; s505_ch = 1;                   // armed (waiting for downbeat) -> red flash
    ) : (g_ci_active && s505_i == g_ci_chan) ? (
      s505_col = C_AMBER; s505_ch = 1;                 // counting in -> amber flash
    ) : s505_st == 2 ? (
      s505_rec[st_mult] == 0 ? ( s505_col = C_RED; s505_ch = 1; )    // first-pass rec (base or measuring) -> red flash
                             : ( s505_col = C_AMBER; s505_ch = 0; );  // overdub onto existing loop -> amber
    ) : s505_st == 1 ? ( s505_col = C_GREEN; s505_ch = 0; )              // playing
      : s505_rec[st_dirty] > 0 ? ( s505_col = C_DIM; s505_ch = 0; )      // stopped w/ content
      : ( s505_col = C_OFF; s505_ch = 0; );                             // empty
    s505_code = s505_col*2 + s505_ch;
    s505_idx = s505_i*8 + 0;
    mem_led_last[s505_idx] != s505_code ? (
      mem_led_last[s505_idx] = s505_code;
      midisend(0, 0x90 + s505_ch, s505_base+1, s505_col);
    );

    // col5 FX (Phase 1 stub: purple on/off)
    s505_col = s505_rec[st_fx] ? C_PURPLE : C_PURPLE_DIM;
    s505_idx = s505_i*8 + 4;
    mem_led_last[s505_idx] != s505_col ? ( mem_led_last[s505_idx]=s505_col; midisend(0,0x90,s505_base+5,s505_col); );

    // col6 SOLO
    s505_col = s505_rec[st_solo] ? C_YELLOW : C_OFF;
    s505_idx = s505_i*8 + 5;
    mem_led_last[s505_idx] != s505_col ? ( mem_led_last[s505_idx]=s505_col; midisend(0,0x90,s505_base+6,s505_col); );

    // col7 MUTE
    s505_col = s505_rec[st_mute] ? C_BLUE : C_OFF;
    s505_idx = s505_i*8 + 6;
    mem_led_last[s505_idx] != s505_col ? ( mem_led_last[s505_idx]=s505_col; midisend(0,0x90,s505_base+7,s505_col); );

    // col8 STATUS + SELECT (per-track loop-position pulse; white if selected)
    s505_rec[st_dirty] > 0 ? (
      (s505_st == 1 || s505_st == 2) ? (
        s505_locallen = max(track_len(s505_rec), 1);
        (s505_rec[st_ppos] % s505_locallen) < (((s505_locallen/8)|0) + 1) ? (
          s505_col = s505_sel ? C_WHITE : C_GREEN;
        ) : (
          s505_col = C_DIM;
        );
      ) : (
        s505_col = s505_sel ? C_WHITE : C_DIM;        // stopped w/ content
      );
    ) : (
      s505_col = s505_sel ? C_UTIL : C_OFF;           // empty
    );
    s505_idx = s505_i*8 + 7;
    mem_led_last[s505_idx] != s505_col ? ( mem_led_last[s505_idx]=s505_col; midisend(0,0x90,s505_base+8,s505_col); );

    s505_i += 1;
  );

  // Row 2 = action pads: cols 1-4 length presets (1/2/4/8 bars; green = the
  // selected track's current bars), cols 5-7 sync mode (amber = active mode),
  // col 8 sync-mode toggle. Dim when no track is selected.
  s505_rec  = (g_chan_selected >= 0 && g_chan_selected < min(g_nchan,5)) ? mem_stlist + g_chan_selected*st_num : -1;
  s505_bars = s505_rec >= 0 ? (s505_rec[st_mult] > 0 ? s505_rec[st_mult] : s505_rec[st_fixlen]) : 0;
  s505_sync = s505_rec >= 0 ? s505_rec[st_sync] : -1;
  s505_i = 0;
  loop(8,
    s505_col =
      s505_i == 0 ? (s505_bars == 1 ? C_GREEN : C_UTIL) :
      s505_i == 1 ? (s505_bars == 2 ? C_GREEN : C_UTIL) :
      s505_i == 2 ? (s505_bars == 4 ? C_GREEN : C_UTIL) :
      s505_i == 3 ? (s505_bars == 8 ? C_GREEN : C_UTIL) :
      s505_i == 4 ? (s505_sync == 0 ? C_AMBER : C_UTIL) :
      s505_i == 5 ? (s505_sync == 1 ? C_AMBER : C_UTIL) :
      s505_i == 6 ? (s505_sync == 2 ? C_AMBER : C_UTIL) :
      C_UTIL;
    mem_led_row2[s505_i] != s505_col ? (
      mem_led_row2[s505_i] = s505_col;
      midisend(0, 0x90, 21+s505_i, s505_col);
    );
    s505_i += 1;
  );
);
