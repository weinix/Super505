@block
g_peak_decay = 10^(-samplesblock/srate*10);


g_prevent_processing &= 0xd;
(g_syncmode=cfgp_sync[]) ? (
  g_offs = 0;
  g_length = (srate * (g_click_int>0?g_click_int:ts_num) * 240.0 / (tempo * ts_denom))|0;
  (play_state&1) ? (
    g_inactive_blockcnt=0;
    g_pos = (play_position*srate + 0.5)%g_length;
  ) : (
    g_syncmode==2 ? (
      g_pos = (play_position*srate + 0.5)%g_length;
      g_prevent_processing |= 2;
    ) : (
      g_pos %= g_length;
    );
  );
  g_firstrec=0; 
);

// RiftwayLabsLooper: one beat of the base measure ("click cnt" = beats per bar; default 4).
// Used by beat-quantized record starts and beat-snapped loop closes.
g_bpb = (cfgp_clickcnt[]|0) > 0 ? (cfgp_clickcnt[]|0) : 4;
g_beatlen = g_length > 0 ? max((g_length/g_bpb)|0,1) : 0;

g_syncmode==0 || (!(play_state&1) && g_syncmode != 2) ? (
  g_active_mask==0 ? (
    <? loop(i=0;nch, printf("%s ch%d.fpos2 > 0.0001\n",i?"||":"",i+1); i+=1; );
       printf("? g_inactive_blockcnt=0;\n"); ?>
    g_inactive_blockcnt < 2 ? (
      g_inactive_blockcnt+=1;
    ) : (
      g_pos = 0;
      g_cycle = 0; g_arm_mask = 0; // loop-sync: master idle reset
