// ===========================================================================

// General notes:
// 8 channels of audio input (1 channel per channel)
// 9 channels of audio output (1 channel per channel, 9th channel is selected-channel-only monitoring output)

// 8 channels are all synchronized. You can turn each channel on and off and overdub on each channel.

// MIDI assignments are mappable by right-click-dragging them in the UI.
//   - right click to cycle note/CC/PC/off
//   - ctrl/cmd+right click to assign to the last MIDI event received
//
// for each channel:
//   - note1=if not recording, start record
//           if already recording (and initial length-setting pass), set length and continue (overdub)
//           if already recording (and length is set), go back to playback
//   - note2=toggle playback (stop/rec->play, play->stop)
//   - note3=toggle selected-for-monitoring
//   - note4=reverse loop
// Right click the channel's monitoring icon to go through off/auto/always-on. 
//   - I use 'off' for things like mic'd drums
//   - I use 'always-on' for stuff where the source should always be audible (usually looping is less important)

// extra buttons:
// - halve length
// - double length
// - double length (no repeat) -- if there's existing content after the current loop, it won't be overwritten
// - x-fade shortened loop: crossfade at the loop boundary, use after shortening a loop
//   fadesize sub-button (drag): fade this amount when halving loop or when running the 
//     x-fade shortened loop command.
//     If you intend to double (no repeat) back up, set to 0ms and accept the clicks.
// - play all: play all channels that have content, or if all channels that have content are playing, stop
// - rec/play selected: cycle the selected channel (or channels, if linked) between stop/record/play/stop
// - add to project: add active channels as .wav files to the end of the project, on their respective tracks,
//   setting the tempo accordingly. (!) This uses a new undocumented (except for this) JSFX API...
// - kill (click) -- delete ALL!

// top menu items:
// - sync: off: classic freeform mode.
//         project: synchronize loop length to project tempo/beat count. if project is playing back
//           then loop is synchronized
//         playback: full transport sync
// - offs/length: (classic freeform only) adjust start/end points of loop
// - click cnt: loop length in clicks. affects metronome output, visual click, and loop length
//              in synchronized modes
// - vclick: visual click, if click cnt is enabled, display offset (or off)
// - start gate: when recording the initial loop, use this gate value before starting recording 
//   (useful for hand-shortages)
// - latch: wait to run commands until next loop iteration

<? nch < 1 ? nch = 8 ?>
<? maxmem < 8 ? maxmem = 256 ?>
<?
  loop(x=0;nch,printf("in_pin:input %d\n",x+=1));
  loop(x=0;nch,printf("out_pin:output %d\n",x+=1));
?>
out_pin:monitor output
out_pin:click output

config: nch "Channels" 8 1 2 4 8="8 (namesake)" 12 16 24 32 48
config: maxmem "Memory Size -preserve-config" 256 64="64MB - max length 0:23 for 8 channels @ 44.1kHz" 128="128MB - max length 0:47 for 8 channels @ 44.1kHz" 256="256MB (default) - max length 1:35 for 8 channels @ 44.1kHz" 512="512MB - max length 3:10 for 8 channels @ 44.1kHz" 1024="1GB - max length 6:20 for 8 channels @ 44.1kHz"

options: maxmem=<? printf("%d",maxmem*1024*128); ?> no_meter gfx_idle prealloc=* gmem=RiftwayLabs

slider1:g_slider_sync=0<0,2,1{off,project,playback}>-Sync
slider4:g_slider_click_cnt=0<0,64,1>-Click count/length
slider5:g_countin=0<0,8,1>-Count-in beats (at project tempo)
slider6:g_slider_action=0<0,8,1{-,SetCurrentTrackLength1Bar,SetCurrentTrackLength2Bars,SetCurrentTrackLength4Bars,SetCurrentTrackLength8Bars,SetCurrentTrackSyncModeFree,SetCurrentTrackSyncModeMeasure,SetCurrentTrackSyncModeMaster,ToggleCurrentTrackSyncMode}>-Action trigger (fires on change, self-resets)

@init

// constants
g_nchan = <? printf("%d",nch) ?>;
g_max_alloc = __memtop(); // JSFX memory available
g_latchq_len = 1024; // 1024 midi events queueable for latch mode
g_maxlen = ((g_max_alloc - 4096 - g_latchq_len*3)/g_nchan)|0; // use nearly all of available memory
g_infthreshdb = -120;
g_infthresh = 10^(g_infthreshdb/20);
g_latchmode=0;

// per-channel state/configuration record (mem_stlist)
st_monmode = 0; // mirrors chX.monmode
st_note1 = 1; // mirrors chX.note/chX.note2/chX.note3/chX.note4
st_note2 = 2;
st_note3 = 3;
st_note4 = 4; // reverse note

st_state = 5; // 0=off, 1=play, 2=recording
st_buf   = 6; // pointer to audio buffer
st_dirty = 7;  // set if buffer is dirty, and also may indicate how much of it 
               // is using max(mem_stlist[st_dirty],chX.dirty_top+1)
st_lastd = 8; // UI flags for mode + monitor + dirty
st_lastpkupd = 9; // time of last peak drawin
st_peak_in = 10;
st_rdc = 11; // msec, chX.rdc is samples
st_div = 12; // subdiv, 1=normal, chX.div is 1/this
st_fade_size = 13; // fadeout size
st_note5 = 14; // RiftwayLabsLooper: per-track CLEAR note
st_note6 = 15; // RiftwayLabsLooper: UNDO note  (Phase 1 stub)
st_note7 = 16; // RiftwayLabsLooper: FX note    (Phase 1 stub)
st_note8 = 17; // RiftwayLabsLooper: SOLO note
st_note9 = 18; // RiftwayLabsLooper: MUTE note
st_mute  = 19; // RiftwayLabsLooper: 0/1 output mute gate (PERSIST)
st_solo  = 20; // RiftwayLabsLooper: 0/1 solo (transient, not persisted)
st_fx    = 21; // RiftwayLabsLooper: 0/1 FX toggle (transient stub)
st_mult   = 22; // RiftwayLabsLooper loop-sync: base-measures this loop spans (>=1; 0=free/unset) (PERSIST)
st_anchor = 23; // RiftwayLabsLooper loop-sync: g_cycle captured at record-start downbeat (PERSIST)
// RiftwayLabsLooper v1 independent-track-length state:
st_sync    = 24; // sync mode: 0=FREE 1=MEASURE_SYNC(default) 2=MASTER_SYNC (PERSIST)
st_qmode   = 25; // quantize: 0=off 1=beat 2=bar(default) for start/stop/rec-close (PERSIST)
st_fixlen  = 26; // preset loop length in bars (0=measure freely); auto-closes rec (PERSIST)
st_len     = 27; // loop length in SAMPLES (authoritative for FREE tracks; mult*g_length for synced)
st_ppos    = 28; // current playback position in samples, within this track's own loop (UI/LED)
st_rectempo= 29; // project tempo captured at record start (bar math for the base track)
st_num = 30;

// Track loop length in samples: synced tracks derive from the base measure so
// halve/double of the base keeps them proportional; FREE tracks own st_len.
function track_len(rec) (
  rec[st_mult] > 0 ? rec[st_mult]*g_length :
  rec[st_len]  > 0 ? rec[st_len] :
  g_length > 0 ? max(floor(g_length/rec[st_div]+0.5),1) : 0;
);

// RiftwayLabsLooper LED palette indices (Launchpad Pro MK3 Programmer mode, velocity =
// color). Verify/tweak with tools/lp_programmer.sh ramp; one line each.
C_OFF   = 0;   // empty
C_RED   = 5;   // recording
C_AMBER = 9;   // overdub
C_GREEN = 21;  // playing
C_DIM   = 45;  // stopped with content
C_WHITE = 3;   // select tint / status pulse peak (static)
C_UTIL  = 1;   // utility row (static, dim)
// RiftwayLabsLooper v2 per-track button colors (Programmer-mode palette indices; tweak w/ ramp)
C_YELLOW    = 13;  // SOLO active
C_BLUE      = 67;  // MUTE active
C_PURPLE    = 49;  // FX active
C_PURPLE_DIM= 50;  // FX off (reserved, dim)
C_UNDO_DIM  = 1;   // UNDO reserved (dim)

function recalc_fades() (
  g_fadespeed = exp(-1/(srate * 0.002));  // fade speed for monitoring
  g_slope_recin = 1/(srate * 0.001); // fade length for starting rec
  g_slope_recout = -1/(srate * 0.030); // fade length for ending rec
  g_slope_playin = 1/(srate * 0.050); // fade length for starting playback
  g_slope_playout = -1/(srate * 0.050); // fade length for ending playback
  g_mutespeed = exp(-1/(srate * 0.005)); // RiftwayLabsLooper: ~5ms mute/solo gate ramp
);

recalc_fades();

function get_section(s) local(r) ( s?(r=s):r; );

function alloc(sz) ( (this.top+=sz)-sz; );

function updatefromrec() instance(rec)
(
  this.note  = rec[st_note1];
  this.note2 = rec[st_note2];
  this.note3 = rec[st_note3];
  this.note4 = rec[st_note4];
  this.monmode = rec[st_monmode];
  this.rdc =(rec[st_rdc]*.001*srate+.5)|0;
  this.div = 1 / rec[st_div];
);

function init(x, n1,n2,n3,n4,n5,n6,n7,n8,n9)
  instance(idx rec buf monvol fpos fpos2 fpos_slope fpos2_slope dirty_top mgate meas_state meas_samples)
(
  idx = x;
  fpos_slope = monvol = fpos = fpos2 = fpos2_slope = 0;
  dirty_top = -1;
  mgate = 1; // RiftwayLabsLooper: output gate starts open (un-muted)
  meas_state = meas_samples = 0; // RiftwayLabsLooper loop-sync: not measuring a length yet
  buf = alloc(g_maxlen);

  rec = mem_stlist + x*st_num;
  rec[st_note1] = n1;
  rec[st_note2] = n2;
  rec[st_note3] = n3;
  rec[st_note4] = n4;
  rec[st_note5] = n5;
  rec[st_note6] = n6; // UNDO
  rec[st_note7] = n7; // FX
  rec[st_note8] = n8; // SOLO
  rec[st_note9] = n9; // MUTE
  rec[st_mute] = 0;
  rec[st_solo] = 0;
  rec[st_fx]   = 0;
  rec[st_mult]   = 0; // loop-sync: unset (base track becomes 1 after first-rec)
  rec[st_anchor] = 0;
  rec[st_sync]   = 1; // default MEASURE_SYNC
  rec[st_qmode]  = 2; // default quantize-to-bar
  rec[st_fixlen] = 0;
  rec[st_len]    = 0;
  rec[st_ppos]   = 0;
  rec[st_rectempo] = 0;
  rec[st_state]=0;
  rec[st_lastd]=-1;
  rec[st_dirty]=0;
  rec[st_monmode] = 1;
  rec[st_buf] = buf;
  rec[st_peak_in] = 0;
  rec[st_rdc] = 0;
  rec[st_div] = 1;
  rec[st_fade_size] = 0;
  
  this.updatefromrec();
);

// clearing the buffer when starting recording on a particular channel
function set_need_zero(dt) global(g_maxlen) instance(need_zero nz_0) (
  need_zero = max(need_zero, min(g_maxlen,dt+1));
  nz_0 = -1;
);
function process_need_zero(p1, p2) global()
  instance(need_zero nz_0 nz_0e nz_1 nz_1e nz_2 buf) 
  local(sz)
(
  nz_0 === -1 ? (
    // three write pointers:  0..p1 p1..p2 p2..need_zero
    nz_0 = 0;
    nz_0e = nz_1 = min(p1,p2);
    nz_1e = nz_2 = max(p1,p2);
  );
  
  (sz = min(8, nz_0e-nz_0)) > 0 ? ( memset(buf + nz_0, 0, sz); nz_0 += sz; );
  (sz = min(8, nz_1e-nz_1)) > 0 ? ( memset(buf + nz_1, 0, sz); nz_1 += sz; );
  (sz = min(8, need_zero-nz_2)) > 0 ? ( memset(buf + nz_2, 0, sz); nz_2 += sz; );
  nz_2 >= need_zero && nz_1 >= nz_1e && nz_0>=nz_0e ? need_zero=0;
);

function setstate(st) instance(fpos_slope, fpos2_slope, rec) local(dt l)
(
  // RiftwayLabsLooper loop-sync: finalize loop length when leaving the record state.
  st != 2 ? (
    this.meas_state == 1 ? (
      // subsequent synced track: snap the measured length to a whole multiple of
      // the base (or exactly the preset bar count, if one was set)
      rec[st_mult] = rec[st_fixlen] > 0 ? max(rec[st_fixlen]|0,1)
                   : max( floor( this.meas_samples / max(g_length,1) + 0.5 ), 1 );
      // if we rounded UP past what was recorded, zero the un-recorded tail so the
      // loop doesn't play stale buffer data.
      this.meas_samples < rec[st_mult]*g_length ? (
        memset(rec[st_buf] + this.meas_samples, 0, rec[st_mult]*g_length - this.meas_samples);
      );
      // MASTER_SYNC: loop window locks to the global bar-1 grid (cycle 0);
      // MEASURE_SYNC: window anchored at this track's own record-start downbeat.
      rec[st_anchor] = rec[st_sync] == 2 ? 0 : rec[st_anchor] % max(rec[st_mult],1);
      rec[st_len] = rec[st_mult]*g_length;
      this.meas_state = 0;
      this.dirty_top = max(this.dirty_top, rec[st_mult]*g_length - 1);
    ) : this.meas_state == 2 ? (
      // FREE / unquantized close: keep the exact measured length. Beat quantize
      // (qmode 1) rounds to whole beats of the base grid when one exists.
      l = this.meas_samples;
      rec[st_qmode] == 1 && g_beatlen > 0 ? l = max(floor(l/g_beatlen + 0.5),1) * g_beatlen;
      l = max(min(l, g_maxlen-1),1);
      l > this.meas_samples ? memset(rec[st_buf] + this.meas_samples, 0, l - this.meas_samples);
      rec[st_len] = l;
      rec[st_mult] = 0;
      rec[st_anchor] = 0;
      this.fppos = 0;    // seamless: the sample after the last recorded one is loop start
      this.meas_state = 0;
      this.dirty_top = max(this.dirty_top, l - 1);
    ) : g_firstrec == 1 + this.idx ? (
      // base/first track defines the grid -> length multiple = 1, anchor 0
      rec[st_mult] = 1;
      rec[st_anchor] = 0;
      rec[st_len] = g_length;
    );
  );
  rec[st_state] ? (
    st==0 ? (
      g_active_mask &= -(1<<this.idx + 1);
    ) : g_length > 0 ? (
      // base track length just closed (2nd rec press -> keep overdubbing, or stop->play)
      g_firstrec == 1 + this.idx ? (
        rec[st_mult] = 1;
        rec[st_anchor] = 0;
        rec[st_len] = g_length;
      );
      g_firstrec = 0;
      g_prevent_processing &= 0xe;
      this.extra_recording = (g_pos == 0 || g_pos == g_length) ? (0|min(srate*.5, g_maxlen-g_length)) : 0;
    );
  ) : (
    st>0 ? (
      // restarting a FREE-position loop from stop: RC-505 restarts from the top
      rec[st_mult] == 0 && rec[st_len] > 0 ? this.fppos = 0;

      st == 2 && (dt = max(rec[st_dirty], this.dirty_top+1)) > 0 ? (
        this.set_need_zero(dt);
        this.dirty_top=-1;
        rec[st_dirty]=0;
      );

      (g_active_mask |= (1<<this.idx)) == (1<<this.idx) && st == 2 ? (
        cfgp_gate[] > g_infthreshdb && cfgp_sync[] == 0 ? (
          g_recstart_gate = 10^(cfgp_gate[]/20);
          g_prevent_processing |= 1;
        ) : (
          g_prevent_processing &= 0xe;
        );
      );

      st == 2 && cfgp_sync[] == 0 && this.meas_state == 0 ? (
        rec[st_sync] != 0 ? (
          g_length == 0 && g_firstrec == 0 ? (
            // no grid yet: this recording defines the base measure (even if a
            // FREE track is already playing -- FREE tracks never own the grid)
            g_pos = g_offs = 0;
            g_cycle = 0;
            g_firstrec = 1+this.idx;
            rec[st_rectempo] = tempo;
          ) : g_length > 0 && g_active_mask == (1<<this.idx) ? (
            // grid exists but everything was stopped: record from the idle bar top
            this.meas_state = 1;
            this.meas_samples = 0;
            rec[st_anchor] = g_cycle;
            rec[st_rectempo] = tempo;
          );
        ) : rec[st_len] <= 0 ? (
          // FREE track, first recording: measure its own length off-grid
          this.meas_state = 2;
          this.meas_samples = 0;
          rec[st_rectempo] = tempo;
        );
      );
    );
  );
  rec[st_state] = st;
  rec[st_dirty] = max(max(rec[st_dirty],this.dirty_top+1),st==2);
  
  st == 2 ? (
    fpos_slope = g_slope_recin;
    fpos2_slope = g_slope_playin;
  ) : (
    fpos_slope = g_slope_recout;
    fpos2_slope = st > 0 ? g_slope_playin :
                  (rec[st_fade_size]>0) ? -1/(rec[st_fade_size]*g_length) :
                  g_slope_playout;
  );
);

function get_linked_rec(idx) ( 
  cfgp_link[]&(1<<(idx>>1)) ? mem_stlist+st_num*(idx~1) : -1; 
);

function is_chan_selected(idx) (
  g_chan_selected == idx ||
    ((cfgp_link[]&(1<<(idx>>1))) && g_chan_selected == idx~1);
);

function setstate_for_rec(rec, state) (
  rec = (rec-mem_stlist)/st_num;
  <? loop(x=0;nch, printf("rec == %d ? ch%d.setstate(state) :\n",x,x+1); x+=1) ?> 0;
);

function play_or_stop_all() local(want_state rec)
(
  want_state = 0;
  rec = mem_stlist;
  loop(g_nchan,
    rec[st_state] != 1 && rec[st_dirty]>0 ? want_state = 1;
    rec += st_num;
  );
  loop(g_nchan,
    rec -= st_num;
    rec[st_state] != want_state && (rec[st_dirty]>0||rec[st_state]) ? setstate_for_rec(rec,want_state);
  );
);

function process_rev(buf)
  instance(rev_state, rev_pos, rev_p0, rev_p1, rev_p2,
           rev_fade_pos, rev_fade_slope, l_length, l_pos, l_offs)
  local(tmpo old)
  global(srate)
(
  // if the user reverses right after starting recording, shrug
  this.need_zero > 0 ? this.process_need_zero(l_offs+l_length,l_offs+l_length);

  // process reverse ahead of the read pointer
  // if l_pos is more than halfway, then we go until the end, then the mirror of the original l_pos+1
  // if l_pos is less than halfway, we go until the halfway point, then to the mirror of the original l_pos+1
  rev_pos === -1 ? (
    rev_pos = (l_length/2)|0; // number of samples we need to reverse, also the halfway point
    rev_fade_slope = 1.0/(srate * 0.030);
    rev_fade_pos = 0;
    rev_p0 = l_pos;
    rev_p1 = l_pos < rev_pos ? rev_pos+1 : l_length;
    rev_p2 = l_length - 1 + 1 - l_pos;
  );
  loop(min(20, rev_pos), // a 10s loop will take 500ms to reverse
    tmpo = buf + l_length - 1 - rev_p0;
    old=buf[rev_p0];
    buf[rev_p0] = tmpo[];
    tmpo[] = old;
    (rev_p0 += 1) == rev_p1 ? rev_p0 = rev_p2;
    rev_pos -= 1;
  );
  rev_fade_pos = min(rev_fade_pos + rev_fade_slope, 1);
  rev_pos == 0 && rev_fade_pos == 1 ? rev_state=0;
  buf[l_pos] * rev_fade_pos + buf[l_length - 1 - l_pos] * (1-rev_fade_pos);
);

function process(s)
  instance(fpos, fpos2, monvol, monmode, rec, peak_in, div, l_length, l_pos, mgate, mgate_t, meas_state, meas_samples, fppos)
  local(r,wrpos,buf,l_offs, sc)
(
  g_prevent_processing===0 ? (
    fpos = min(max(0,fpos+this.fpos_slope),1);
    sc = sqr(fpos2 = min(max(0,fpos2+this.fpos2_slope),1));
  ) : (
    fpos = fpos2 = sc = 0;
  );
  peak_in = max(abs(s),peak_in);

  // --- RiftwayLabsLooper independent-track-length model ---
  // l_length is this track's own loop length (base measure for synced tracks
  // while recording; mult*g_length or st_len when set). l_pos is the per-channel
  // buffer index: synced mult>1 loops span [0, mult*g_length) across base cycles,
  // anchored so all tracks share the base downbeat; FREE loops run their own
  // position counter (fppos). mult<=1 and no free length -> l_pos=g_pos (factory).
  l_length = g_length;
  l_offs = g_offs;
  meas_state == 1 ? (
    // MEASURING a subsequent synced track: write MONOTONICALLY across base
    // measures (buffer index grows past one base measure), bounded by g_maxlen.
    // The recorded sample count is tallied so we can snap to a whole multiple
    // (or close exactly at the preset bar count) on stop.
    wrpos = (g_cycle - rec[st_anchor]) * g_length + g_pos;
    wrpos >= g_maxlen ? wrpos = g_maxlen - 1;
    l_pos = wrpos;
    meas_samples += 1;
    rec[st_fixlen] > 0 && g_length > 0 && meas_samples >= rec[st_fixlen]*g_length ? this.setstate(1);
  ) : meas_state == 2 ? (
    // MEASURING a FREE(-quantize) track: write monotonically from buffer top;
    // the exact sample count becomes the loop length on close.
    wrpos = meas_samples;
    wrpos >= g_maxlen ? wrpos = g_maxlen - 1;
    l_pos = wrpos;
    l_length = max(meas_samples,1);
    l_offs = 0;
    meas_samples += 1;
  ) : rec[st_mult] == 0 && rec[st_len] > 0 ? (
    // FREE loop playback/overdub: track-owned position, own length
    l_length = rec[st_len];
    l_pos = fppos;
    (fppos += 1) >= rec[st_len] ? fppos = 0;
    l_offs = 0;
    wrpos = l_pos;
  ) : (
    (rec[st_mult] > 1 && g_firstrec === 0 && cfgp_sync[] == 0) ? (
      l_pos = ((g_cycle - rec[st_anchor]) % rec[st_mult]) * g_length + g_pos;
      l_pos < 0 ? l_pos += rec[st_mult]*g_length;
    ) : (
      l_pos = g_pos;
      div < 1 ? ( // legacy subdivision (div knob deprecated; default 1 -> no-op)
        l_length = max((g_length*div+0.5)|0,1);
        g_firstrec === 0 ? ( l_pos %= l_length; l_offs %= l_length; );
      );
    );
    wrpos = l_pos;
  );
  rec[st_ppos] = l_pos;   // per-track playback position (Launchpad status / UI)
  buf = this.buf + l_offs;
  // extra_recording + rdc only for normal looped/playing tracks (not first-rec, not measuring)
  g_firstrec === 0 && meas_state === 0 ? (
    this.extra_recording > 0 ? (
      buf[l_length + l_pos] = s; // write past the end of the loop (in case we want to trim later)
      this.dirty_top = max(this.dirty_top,l_length + l_pos + l_offs);
      this.extra_recording -= 1;
    );

    this.rdc < l_length ? (
      wrpos -= this.rdc;
      wrpos < 0 ? wrpos += l_length;
    );
  );
  this.need_zero > 0 ? this.process_need_zero(l_offs+wrpos,l_offs+l_pos);
  
  r = this.rev_state!==0 ? this.process_rev(buf)*sc : sc > 0.0001 ? buf[l_pos]*sc;
  // RiftwayLabsLooper: ramp the per-track MUTE/SOLO gate (~5ms) and apply to loop playback only
  // (live monitor s*monvol is left ungated, matching RC-505 mute semantics).
  mgate += (mgate_t - mgate) * (1 - g_mutespeed);
  r *= mgate;
  monmode === 0 ? (
    // no monitoring
    fpos > 0.0001 ? (
      this.dirty_top = max(this.dirty_top,wrpos + l_offs);
      buf[wrpos] += s*fpos;
    );
    r;
  ) : (
    this.monmode_sel ? (
      monvol = 1 + (monvol-1)*g_fadespeed;
    ) : ( 
      monvol *= g_fadespeed;
    );
    
    fpos > 0.0001 ? (
      this.dirty_top = max(this.dirty_top,wrpos + l_offs);
      wrpos == l_pos ? (
        buf[l_pos] += s*fpos;
        r + s*max(fpos*sc, monvol);
      ) : (
        buf[wrpos] += s*fpos;
        r + s * monvol;
      );
    ) : (
      r + s*monvol;
    );
  );
);

function rev_stop() instance (rec)
(
  atomic_set(this.rev_requested,0);
  this.rev_state=0;
);

function reverse() instance(rec) local(l)
(
  atomic_add(this.rev_requested,1);
  l = (g_length * this.div)|0;
  rec[st_dirty] = this.dirty_top = max(rec[st_dirty],max(this.dirty_top,l));
  rec[st_lastd] = -1;
);

// RiftwayLabsLooper: erase ONLY this channel's loop (RC-505 per-track Clear).
// Mirrors reset() for a single channel but leaves g_length/g_pos and the other
// channels untouched, so the rest of the loop keeps playing.
function chan_clear() instance(rec dirty_top idx)
(
  this.setstate(0);     // latches dirty, stops the channel
  this.rev_stop();
  dirty_top = -1;
  rec[st_dirty] > 0 ? (
    memset(rec[st_buf], 0, rec[st_dirty]);
    rec[st_dirty] = 0;
  );
  rec[st_lastd] = -1;   // force UI redraw
  // loop-sync: forget length/phase + cancel any pending measure/arm so a re-record
  // measures fresh (sync/quantize/fixlen are SETTINGS and survive a clear)
  rec[st_mult] = 0;
  rec[st_anchor] = 0;
  rec[st_len] = 0;
  rec[st_ppos] = 0;
  this.meas_state = 0; this.meas_samples = 0; this.fppos = 0;
  (g_arm_mask & (1<<idx)) ? (g_arm_mask -= (1<<idx));
  // if this channel was still defining the (not-yet-set) loop length, cancel it
  g_firstrec == 1 + idx ? g_firstrec = 0;
);

function onmsg(m1,m2,m3) instance(rec,note,note2,note3,note4)
  local(newstate)
(
   newstate = -1;
   (m2 == note && (m2 != note2 || rec[st_state]==0)) || m2 == 1024+rec+st_note1 ? (
     newstate = (rec[st_state] == 2 && g_was_firstrec==0) ? 1 : 2;
   ) : m2 == note2  || m2 == 1024+rec+st_note2 ? (
     // RiftwayLabsLooper: a stopped FREE track has its own length even when no grid exists
     newstate = rec[st_state] == 2 || (rec[st_state]==0 && (g_length || rec[st_len])) ? 1 : 0
   ) : m2 == note3 ? (
     g_chan_selected = (g_chan_selected == this.idx) ? -1 : this.idx;
   ) : m2 == note4 || m2 == 1024+rec+st_note4 ? (
     this.reverse();
   ) : m2 == rec[st_note5] ? (        // RiftwayLabsLooper: per-track Clear
     this.chan_clear();
   ) : m2 == rec[st_note8] ? (        // RiftwayLabsLooper: SOLO toggle
     rec[st_solo] = !rec[st_solo];
   ) : m2 == rec[st_note9] ? (        // RiftwayLabsLooper: MUTE toggle
     rec[st_mute] = !rec[st_mute];
   ) : m2 == rec[st_note7] ? (        // RiftwayLabsLooper: FX toggle (Phase 1 stub: LED only)
     rec[st_fx] = !rec[st_fx];
   );
   // note6 UNDO: Phase 1 stub — pad reserved/lit, no action yet (Phase 2 -> chan_undo()).
   newstate >= 0 ? (
     // RiftwayLabsLooper count-in: a press on the channel that is counting cancels it
     (g_ci_active && this.idx == g_ci_chan) ? (
       g_ci_active = 0; g_ci_chan = -1;
     ) :
     // RiftwayLabsLooper loop-sync: a press on an armed (waiting-for-downbeat) channel cancels it
     (g_arm_mask & (1<<this.idx)) ? (
       g_arm_mask -= (1<<this.idx);
     ) :
     // RiftwayLabsLooper loop-sync: subsequent track on an existing base grid -> ARM for a
     // quantized record start (fires at the next base downbeat -- or next beat, if
     // this track quantizes to beats -- in @sample), instead of recording now.
     // FREE tracks and quantize-off tracks skip arming and record immediately,
     // measuring their own loop length. (The base/first track has g_length==0
     // and falls through.)
     (newstate == 2 && rec[st_state] == 0 && rec[st_dirty] == 0 && g_length > 0 && g_firstrec == 0 && cfgp_sync[] == 0 && g_active_mask != 0) ? (
       (rec[st_sync] == 0 || rec[st_qmode] == 0) ? (
         this.setstate(2);
         this.meas_state = 2;
         this.meas_samples = 0;
         rec[st_rectempo] = tempo;
       ) : (
         g_arm_mask |= (1<<this.idx);
       );
       g_chan_selected = this.idx;
     ) :
     // arm a count-in (instead of recording now) when starting a fresh empty loop
     (newstate == 2 && rec[st_state] == 0 && rec[st_dirty] == 0 && g_countin > 0 && g_ci_active == 0) ? (
       g_ci_active = 1;
       g_ci_chan = this.idx;
       g_ci_beat_len = (srate * 60 / max(tempo,1))|0;
       g_ci_samples_left = g_countin * g_ci_beat_len;
       g_ci_next_click = 0;
       g_ci_click_env = 0;
       g_chan_selected = this.idx;
     ) : (
       this.setstate(newstate);
       setstate_for_rec(get_linked_rec(this.idx), newstate);
       g_chan_selected = this.idx;
     );
   );
);

function redraw_channels() local(p)
(
  p=mem_stlist+st_lastd;
  loop(g_nchan,
    p[0] = -1;
    p+=st_num;
  );
);

function repeatbuf(buf,osz, nsz) local(p,s)
(
  p=buf+osz;
  while (p < buf+nsz) 
  (
    s = min(buf+nsz-p,osz);
    memcpy(p,buf,s);
    p+=s;
  ); 
);

function xfadebuf(buf, osz, nsz) local(fsz,s,ds)
(
  fsz = (0.001*cfgp_fade[]*srate)|0;
  s=0;
  osz>0 && osz == nsz ? osz += fsz;
  fsz = min(fsz,osz-nsz)|0;
  ds=1/fsz;
  // fade buf[0..fsz] with buf[nsz..nsz+fsz] 
  loop(fsz,
    buf[0] = buf[0] * s + buf[nsz]*(1-s);
    s+=ds;
    buf+=1;
  );
 
);

// ================= RiftwayLabsLooper action dispatcher =================
// Named actions operate on the CURRENT (selected) track. Triggered from:
//   - Launchpad row 2 (notes 21..28 -> action ids 1..8)
//   - the "Action trigger" slider (automation / MIDI-learn / ReaScript)
// ids: 1=SetCurrentTrackLength1Bar  2=SetCurrentTrackLength2Bars
//      3=SetCurrentTrackLength4Bars 4=SetCurrentTrackLength8Bars
//      5=SetCurrentTrackSyncModeFree 6=SetCurrentTrackSyncModeMeasure
//      7=SetCurrentTrackSyncModeMaster 8=ToggleCurrentTrackSyncMode

function set_fppos_for_rec(rec, v) (
  rec = (rec-mem_stlist)/st_num;
  <? loop(x=0;nch, printf("rec == %d ? ch%d.fppos = v :\n",x,x+1); x+=1) ?> 0;
);

function s505_set_len_bars(n) local(rec oldlen newlen)
(
  g_chan_selected >= 0 ? (
    rec = mem_stlist + g_chan_selected*st_num;
    rec[st_fixlen] = n;   // preset: recordings on this track auto-close at n bars
    // existing synced loop: re-snap to n bars right now (extend repeats content,
    // shrink truncates to the first n bars); phase stays on the shared grid.
    rec[st_state] != 2 && rec[st_dirty] > 0 && rec[st_mult] > 0 && g_length > 0 && n != rec[st_mult] ? (
      oldlen = rec[st_mult]*g_length;
      newlen = min(n*g_length, g_maxlen-1);
      newlen > oldlen ? (
        repeatbuf(rec[st_buf] + g_offs, oldlen, newlen);
        rec[st_dirty] = max(rec[st_dirty], newlen + g_offs);
      );
      rec[st_mult] = max((newlen/max(g_length,1))|0, 1);
      rec[st_len] = rec[st_mult]*g_length;
      rec[st_anchor] = rec[st_sync] == 2 ? 0 : rec[st_anchor] % rec[st_mult];
      rec[st_lastd] = -1;
    );
  );
);

function s505_set_sync(m) local(rec ph)
(
  g_chan_selected >= 0 ? (
    rec = mem_stlist + g_chan_selected*st_num;
    m != rec[st_sync] ? (
      m == 2 && rec[st_mult] > 0 ? (
        rec[st_anchor] = 0;              // MASTER: re-lock the loop window to bar 1
      ) : m == 0 && rec[st_mult] > 0 && g_length > 0 ? (
        // detach a synced loop: freeze current length + phase, continue as FREE
        rec[st_len] = rec[st_mult]*g_length;
        ph = (g_cycle - rec[st_anchor]) % rec[st_mult];
        ph < 0 ? ph += rec[st_mult];
        set_fppos_for_rec(rec, ph*g_length + g_pos);
        rec[st_mult] = 0;
        rec[st_anchor] = 0;
      );
      // FREE -> MEASURE/MASTER with existing free content: the free length rarely
      // divides the grid, so the mode applies to the NEXT recording; playback of
      // the current free loop is unchanged.
      rec[st_sync] = m;
      rec[st_lastd] = -1;
    );
  );
);

function s505_action(aid) local(rec)
(
  aid == 1 ? s505_set_len_bars(1) :
  aid == 2 ? s505_set_len_bars(2) :
  aid == 3 ? s505_set_len_bars(4) :
  aid == 4 ? s505_set_len_bars(8) :
  aid >= 5 && aid <= 7 ? s505_set_sync(aid-5) :
  aid == 8 && g_chan_selected >= 0 ? (
    rec = mem_stlist + g_chan_selected*st_num;
    s505_set_sync((rec[st_sync]+1)%3);
  );
);
