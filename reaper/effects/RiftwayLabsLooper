function doconf() local(i,s) (
  i=mem_stlist;
  loop(g_nchan,
    file_var(0,i[st_monmode]);
    i+=st_num;
  );
  
  s=mem_gen_sz; // safe to increase mem_gen_sz without breaking compat
  file_var(0,s);

  i=0;
  loop(s,
    file_var(0,i < mem_gen_sz ? mem_gen_cfg[i] : 0);
    i+=1;
  );
  
  i = mem_stlist;
  loop(g_nchan,
    file_var(0,i[st_note1]);
    file_var(0,i[st_note2]);
    file_var(0,i[st_note3]);
    i+=st_num;
  );
  
  file_avail(0) != 0 ? (
    i = mem_stlist;
    loop(g_nchan,
      file_var(0,i[st_note4]);
      i+=st_num;
    );  
  );

  loop(x=0;3, // st_rdc, st_div, st_fade_size
    file_avail(0) != 0 ? (
      i = mem_stlist;
      loop(g_nchan,
        file_var(0,i[st_rdc+x]);
        i+=st_num;
      );
    );
    x+=1;
  );

  // RiftwayLabsLooper v2: persist CLEAR + new pad notes and the MUTE gate. st_note5=14 ..
  // st_note9=18, st_mute=19 are contiguous, so one loop covers all six. SOLO/FX
  // and undo state are intentionally NOT persisted (transient). file_avail guards
  // keep old projects (which lack these) loading cleanly.
  loop(x=0;6,
    file_avail(0) != 0 ? (
      i = mem_stlist;
      loop(g_nchan,
        file_var(0,i[st_note5+x]);
        i+=st_num;
      );
    );
    x+=1;
  );

  // RiftwayLabsLooper loop-sync: persist st_mult + st_anchor (contiguous: 22,23). Old
  // projects lack these -> file_avail guard skips them, keeping back-compat.
  loop(x=0;2,
    file_avail(0) != 0 ? (
      i = mem_stlist;
      loop(g_nchan,
        file_var(0,i[st_mult+x]);
        i+=st_num;
      );
    );
    x+=1;
  );

  // RiftwayLabsLooper v1: persist per-track sync mode / quantize mode / fixed-length
  // preset (contiguous: st_sync=24, st_qmode=25, st_fixlen=26). Same
  // file_avail back-compat guard as above.
  loop(x=0;3,
    file_avail(0) != 0 ? (
      i = mem_stlist;
      loop(g_nchan,
        file_var(0,i[st_sync+x]);
        i+=st_num;
      );
    );
    x+=1;
  );

  file_avail(0)>=0 ? ( // is reading config
    // RiftwayLabsLooper v2: re-assert the ROWS=tracks pad layout, overriding any stale
    // note assignments restored from an older (column-layout) project. st_mute
    // is left as read (mute state persists); only the note map is forced.
    <? loop(x=0; nch,
        x < 5 ? (
          r = 8 - x;
          printf("i=mem_stlist+%d*st_num; i[st_note1]=%d;i[st_note2]=%d;i[st_note3]=%d;i[st_note4]=128;i[st_note5]=%d;i[st_note6]=%d;i[st_note7]=%d;i[st_note8]=%d;i[st_note9]=%d;\n",
            x, r*10+1,r*10+2,r*10+8,r*10+3,r*10+4,r*10+5,r*10+6,r*10+7);
        ) :
          printf("i=mem_stlist+%d*st_num; i[st_note1]=128;i[st_note2]=128;i[st_note3]=128;i[st_note4]=128;i[st_note5]=128;i[st_note6]=128;i[st_note7]=128;i[st_note8]=128;i[st_note9]=128;\n", x);
        x+=1;
       )
     ?>
    updatechfromrec();
    // loop-sync: phase re-locks at load (audio buffers aren't persisted), so reset
    // the master cycle and clear per-channel anchors -> st_mult still defines length.
    g_cycle = 0;
    i = mem_stlist; loop(g_nchan, i[st_mult]=0; i[st_anchor]=0; i[st_len]=0; i[st_ppos]=0; i+=st_num;); // buffers aren't restored -> tracks start empty (sync/qmode/fixlen settings survive)
    g_slider_sync = cfgp_sync[];
    g_latchmode = cfgp_latch[];
    g_slider_click_cnt = cfgp_clickcnt[]|0;
    last_w=0;
