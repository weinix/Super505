  nextmsg_offs = 0;
  nextmsg_1=0x90;
  nextmsg_2=g_inject_midinote;
  nextmsg_3=127;
  g_inject_midinote=0;
) : (
  // RiftwayLabsLooper: read the next message for processing but DON'T echo it back out —
  // the track MIDI output is reserved for LED control.
  midirecv(nextmsg_offs,nextmsg_1,nextmsg_2,nextmsg_3);
