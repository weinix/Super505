function chan_onmsg(m1,m2,m3)
(
  g_was_firstrec = g_firstrec; // latch to this value for any messages that apply to multiple channels
  (m2 == cfgp_playsel[] || m2 == 1024+cfgp_playsel) && g_chan_selected>=0 ? (
    m2 = 1024 + mem_stlist + g_chan_selected*st_num + st_note1 + 
      (mem_stlist[g_chan_selected*st_num + st_state]?1:0);
  );

  m2 == cfgp_playall[] || m2 == 1024+cfgp_playall ? play_or_stop_all();
  // RiftwayLabsLooper: Launchpad row 2 = action pads (length presets + sync mode)
  m2 >= 21 && m2 <= 28 ? s505_action(m2-20);
  <? loop(x=0;nch, printf("ch%d.onmsg(m1,m2,m3);\n",x+=1)) ?>
);

function latchq_add(m1,m2,m3) local(v)
(
  g_latchq_used < g_latchq_len ? 
  (
    v = g_latchq_used*3;
    g_latchq[v]=m1;
    g_latchq[v+1]=m2;
    g_latchq[v+2]=m3;
    g_latchq_used+=1;
  );
);

function latchq_process() local(r)
(
  r=g_latchq;
  loop(g_latchq_used,
    chan_onmsg(r[0],r[1],r[2]);
    r+=3;
  );
  g_latchq_used=0;
);


function tonegen(x) (
  1/*change to 0 for sine*/ ? (
    x = x - floor(x);
    4 * (x < 0.25 ? x : x < 0.75 ? 0.5-x : (x-1));
  ) : sin(x*2*$pi);
);

function generate_click() 
  global(g_pos, g_length, i_srate, 
         g_click_int, g_click_lenspls, g_click_fadesz, g_click_fadesz_i)
  local(s, int)
(
  int = (g_length/g_click_int);
  s = g_pos - floor(g_pos/int)*int;
  s < g_click_lenspls ? (
    (s < g_click_lenspls-g_click_fadesz ? 1 : ( (g_click_lenspls-s)*g_click_fadesz_i )) * (
       g_pos < int ? 
         tonegen(s*800*i_srate)*1 
       :
         tonegen(s*1600*i_srate)*.75; 
    );
  );
);

g_latchq_used>0 && (g_pos == 0 || g_firstrec) ? latchq_process();

while (sidx == nextmsg_offs)
(
  nextmsg_1 == 0xb0 ? ( nextmsg_1 = 0x90; nextmsg_2 += 129; ) :
  nextmsg_1 == 0xc0 ? ( nextmsg_1 = 0x90; nextmsg_2 += 129*2; nextmsg_3=127; );

  nextmsg_1 == 0x90 && nextmsg_3 != 0  ? (
    (!g_latchmode || g_pos == 0 || g_firstrec) ? (
      chan_onmsg(nextmsg_1,nextmsg_2,nextmsg_3);    
    ) : (
      latchq_add(nextmsg_1,nextmsg_2,nextmsg_3);
    );
    
    nextmsg_2 == cfgp_reset[]        ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "r")) :
    nextmsg_2 == cfgp_halve[]        ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "h")) :
    nextmsg_2 == cfgp_double[]       ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "d")) :
    nextmsg_2 == cfgp_double_norep[] ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "D")) :
    nextmsg_2 == cfgp_export[]       ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "e")) :
    nextmsg_2 == cfgp_xfade[]        ? (strlen(#mainthread_todo)<100 ? strcat(#mainthread_todo, "x"));
      
    nextmsg_2 < 1024 ? g_lastmsg = nextmsg_2;
  );
  nextmsg_offs=-1;
  midirecv(nextmsg_offs,nextmsg_1,nextmsg_2,nextmsg_3); // RiftwayLabsLooper: no echo (LED output)
);

sidx+=1;
g_chan_selected >= 0 ? (
  g_chan_peak = abs(spl(g_chan_selected));
  g_peakvol = max(g_chan_peak,g_peakvol);
  
  g_prevent_processing==1 && g_firstrec ? (
    g_chan_peak >= g_recstart_gate ? g_prevent_processing = 0;
  );
);

g_pos >= g_length && g_firstrec == 0 ? ( g_pos = 0; g_cycle += 1; ); // loop-sync: advance base measure

<? loop(x=0;nch, printf("spl%d=ch%d.process(spl%d);\n",x,x+1,x);x+=1) ?>

// ---- RiftwayLabsLooper count-in: click g_countin beats at project tempo, then record ----
g_ci_active ? (
  g_ci_next_click <= 0 ? (                  // start a new click blip each beat
    g_ci_click_env = 1.0;
    g_ci_click_phase = 0;
    g_ci_next_click += g_ci_beat_len;
  );
  g_ci_next_click -= 1;
  g_ci_click_env > 0.0001 ? (
    g_ci_click_phase += 1500 * i_srate;     // ~1.5 kHz metronome click
    g_ci_out = tonegen(g_ci_click_phase) * g_ci_click_env * 0.3;
    spl0 += g_ci_out;                        // onto ch1/2 so the mixdown makes it audible
    spl1 += g_ci_out;
    g_ci_click_env *= 0.992;                 // ~20 ms decay
  );
  (g_ci_samples_left -= 1) <= 0 ? (          // count-in done -> start recording now
    setstate_for_rec(mem_stlist + g_ci_chan*st_num, 2);
    g_ci_active = 0;
    g_ci_chan = -1;
  );
);

g_prevent_processing===0 ? (
  g_click_int > 0 && g_active_mask && g_length > 0 && !g_firstrec ? (
    <? printf("spl%d",nch+1) ?> = generate_click();
  );

  g_firstrec !== 0 ? (
     (g_pos+=1) >= g_maxlen ? (
       mem_stlist[(g_firstrec-1)*st_num + st_mult]=1;   // loop-sync: base track = 1x
       mem_stlist[(g_firstrec-1)*st_num + st_anchor]=0;
       mem_stlist[(g_firstrec-1)*st_num + st_len]=g_length;
       g_firstrec=0;
       g_pos=0;
       g_cycle=0;
     ) : (
       g_length = g_pos *
            ((g_firstrec > 0 && g_firstrec < 1 + g_nchan) ?
              mem_stlist[(g_firstrec-1)*st_num + st_div] : 1);
       // fixed-length preset on the base track: auto-close the recording once it
       // reaches N bars of the tempo captured at record start (project time sig)
       g_s505_fix = mem_stlist[(g_firstrec-1)*st_num + st_fixlen];
       g_s505_fix > 0 && g_length >=
         ((g_s505_fix * srate * ts_num * 240 /
           (max(mem_stlist[(g_firstrec-1)*st_num + st_rectempo],1) * ts_denom))|0) ? (
         setstate_for_rec(mem_stlist + (g_firstrec-1)*st_num, 1);
       );
     );
  ) : (
    (g_pos += 1) >= g_length ? (
      g_pos = 0; g_cycle += 1;                  // loop-sync: advance base measure
      g_arm_mask ? (  // bar-quantized (default) armed channels start at the downbeat
        <? loop(x=0;nch,
             printf("(g_arm_mask & %d) && mem_stlist[%d*st_num+st_qmode] != 1 ? ( g_arm_mask -= %d; mem_stlist[%d*st_num+st_anchor]=g_cycle; mem_stlist[%d*st_num+st_rectempo]=tempo; ch%d.setstate(2); ch%d.meas_state=1; ch%d.meas_samples=0; );\n",
                    1<<x, x, 1<<x, x, x, x+1, x+1, x+1); x+=1) ?>
      );
    );
    // beat-quantized armed channels start at ANY beat boundary (incl. the downbeat);
    // they measure their own free length, beat-snapped on close.
    g_arm_mask && g_beatlen > 0 && (g_pos % g_beatlen) == 0 ? (
      <? loop(x=0;nch,
           printf("(g_arm_mask & %d) && mem_stlist[%d*st_num+st_qmode] == 1 ? ( g_arm_mask -= %d; mem_stlist[%d*st_num+st_rectempo]=tempo; ch%d.setstate(2); ch%d.meas_state=2; ch%d.meas_samples=0; );\n",
                  1<<x, x, 1<<x, x, x+1, x+1, x+1); x+=1) ?>
    );
  );
);

<? printf("spl%d",nch) ?> = g_chan_selected >= 0 ? spl(g_chan_selected);

